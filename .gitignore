# What this repository can produce that must not be committed.
#
# Only skills/ ships; everything else here is maintainer material.
# Nothing in this repository is built or compiled, so there are no
# build outputs to ignore -- the entries below are local tooling,
# secrets, and editor or OS scratch.

# Agent harness config, and agent skills installed for development
# only (e.g. genesis). Installed skills are never committed: see
# docs/devs/design-process.md for what they are and how to re-add
# them. This repo's own skills live in skills/ and are loaded with
# `claude --plugin-dir .`, so nothing needs to be mirrored here.
.claude/settings.local.json
.claude/skills/
.agents/

# Secrets and local environment
*.env
.env
.env.*

# Python, for the PyYAML that tests/check-workflow-template.sh needs
.venv/
venv/
__pycache__/
*.pyc

# Editors
.vscode/
.idea/
.history/
*~

# OS scratch
.DS_Store
Thumbs.db
Desktop.ini
